RUBIKA_PHONE=
GITHUB_TOKEN=
DOWNLOAD_DIR=./downloads
DATABASE_PATH=./data/github_bridge.db
MAX_DOWNLOAD_SIZE_MB=
MAX_CONCURRENT_DOWNLOADS=2
CACHE_TTL=300
LOG_LEVEL=INFO

# ─── Optional ───────────────────────────────────────────────
# RUBIKA_SESSION=./data/rubika_session   # rubpy appends ".rp"; keep it private
# MAX_STORAGE_MB=6000                    # quota for DOWNLOAD_DIR
# MIN_FREE_MB=300                        # minimum free disk space kept
# PAGE_SIZE=5                            # releases per page
# MAX_RETRIES=5
# SEND_DELAY_SECONDS=3                   # pause between uploaded parts
